DOTAMIND_ENVIRONMENT=local
DOTAMIND_API_V1_PREFIX=/api/v1
DOTAMIND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3012","http://localhost:3013"]
DOTAMIND_POLICY_PATH=

DOTAMIND_LIVE_DATA_ENABLED=false
DOTAMIND_OPENDOTA_API_KEY=
DOTAMIND_OPENDOTA_BASE_URL=https://api.opendota.com/api
DOTAMIND_PANDASCORE_TOKEN=
DOTAMIND_PANDASCORE_BASE_URL=https://api.pandascore.co
DOTAMIND_STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
DOTAMIND_STRATZ_TOKEN=
DOTAMIND_OPENAI_API_KEY=

DOTAMIND_LLM_ENABLED=false
DOTAMIND_LLM_PROVIDER=deepseek
DOTAMIND_LLM_API_KEY=
DOTAMIND_LLM_BASE_URL=https://api.deepseek.com
DOTAMIND_LLM_MODEL=deepseek-chat
DOTAMIND_TEST_OBSERVER_ENABLED=true
DOTAMIND_DATABASE_URL=postgresql://dotamind:dotamind@localhost:5432/dotamind
DOTAMIND_SESSION_STORE_BACKEND=redis
DOTAMIND_REDIS_URL=redis://localhost:6379/0
DOTAMIND_VNEXT_ARTIFACT_TTL_SECONDS=604800
DOTAMIND_VNEXT_TRACE_TTL_SECONDS=259200
DOTAMIND_MAX_CONCURRENT_CHAT_RUNS=2
DOTAMIND_RUN_HEARTBEAT_SECONDS=5
DOTAMIND_RUN_STALE_SECONDS=60
DOTAMIND_RUN_SWEEPER_INTERVAL_SECONDS=15

NEXT_PUBLIC_DOTAMIND_API_URL=http://localhost:8001
NEXT_PUBLIC_DOTAMIND_TEST_OBSERVER_ENABLED=true
