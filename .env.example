METAMIND_ENVIRONMENT=local
METAMIND_API_V1_PREFIX=/api/v1
METAMIND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3012","http://localhost:3013"]

METAMIND_OPENDOTA_BASE_URL=https://api.opendota.com/api
METAMIND_STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
METAMIND_STRATZ_TOKEN=
METAMIND_OPENAI_API_KEY=

METAMIND_LLM_ENABLED=false
METAMIND_LLM_PROVIDER=deepseek
METAMIND_LLM_API_KEY=
METAMIND_LLM_BASE_URL=https://api.deepseek.com
METAMIND_LLM_MODEL=deepseek-chat

METAMIND_DATABASE_URL=postgresql://metamind:metamind@localhost:5432/metamind
METAMIND_REDIS_URL=redis://localhost:6379/0

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_EXPERIMENTAL_API_BASE_URL=http://127.0.0.1:8000
