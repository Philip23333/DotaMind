DOTAMIND_ENVIRONMENT=local
DOTAMIND_API_V1_PREFIX=/api/v1
DOTAMIND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3012","http://localhost:3013"]
DOTAMIND_POLICY_PATH=

DOTAMIND_LIVE_DATA_ENABLED=false
DOTAMIND_OPENAI_API_KEY=

DOTAMIND_LLM_ENABLED=false
DOTAMIND_LLM_PROVIDER=deepseek
DOTAMIND_LLM_API_KEY=
DOTAMIND_LLM_BASE_URL=https://api.deepseek.com
DOTAMIND_LLM_MODEL=deepseek-chat
# Independent vNext Agent execution and answer wall-clock budgets, in seconds.
DOTAMIND_EXECUTION_DEADLINE_SECONDS=300
# Includes answer preparation, compaction/recovery, primary, and degraded calls.
DOTAMIND_ANSWER_DEADLINE_SECONDS=60
DOTAMIND_PANDASCORE_BASE_URL=https://api.pandascore.co
DOTAMIND_PANDASCORE_TOKEN=
DOTAMIND_PANDASCORE_TIMEOUT_SECONDS=20
# Optional STRATZ player profile lookup; player.profile registers only when a token is set.
DOTAMIND_STRATZ_GRAPHQL_URL=https://api.stratz.com/graphql
DOTAMIND_STRATZ_TOKEN=
DOTAMIND_STRATZ_TIMEOUT_SECONDS=20
# OpenDota single-game details; game.detail registers only when explicitly enabled.
DOTAMIND_OPENDOTA_ENABLED=false
DOTAMIND_OPENDOTA_BASE_URL=https://api.opendota.com/api
DOTAMIND_OPENDOTA_API_KEY=
DOTAMIND_OPENDOTA_TIMEOUT_SECONDS=20
# Optional Tavily remote MCP web search; requires an API key when enabled.
DOTAMIND_TAVILY_MCP_ENABLED=false
DOTAMIND_TAVILY_MCP_URL=https://mcp.tavily.com/mcp
DOTAMIND_TAVILY_API_KEY=
DOTAMIND_TAVILY_MCP_TIMEOUT_SECONDS=30
# Initial database-history bootstrap only; active session execution history is not trimmed by these values.
DOTAMIND_HISTORY_BOOTSTRAP_MAX_TURNS=12
DOTAMIND_HISTORY_BOOTSTRAP_MAX_CHARS=40000
# Bounded per-session Artifact locator list; evicting a locator does not delete the Artifact.
DOTAMIND_ARTIFACT_LOCATOR_CAPACITY=16
DOTAMIND_ARTIFACT_LOCATOR_HINT_CHARS=256
# Default timeout for tools without a tool-specific timeout, in finite positive seconds.
DOTAMIND_TOOL_TIMEOUT_SECONDS=60
# Explicit model context window; leave blank to disable automatic capacity governance.
DOTAMIND_CONTEXT_WINDOW_TOKENS=
# Known per-response output limit for the selected model/provider, if configured.
DOTAMIND_MODEL_MAX_OUTPUT_TOKENS=
# Optional application ceiling; at least one of the model or application caps is required.
DOTAMIND_APPLICATION_MAX_OUTPUT_TOKENS=
# Safety buffer held back after estimating the current request input.
DOTAMIND_CONTEXT_SAFETY_MARGIN_TOKENS=1024
# Heuristic bytes per token used to estimate request size.
DOTAMIND_CONTEXT_ESTIMATE_BYTES_PER_TOKEN=2
# Blank selects the production threshold: estimated input > window - compaction reserve.
# Leave blank for production. Set to 30 for local early-compaction tests.
DOTAMIND_CONTEXT_COMPACTION_TEST_TRIGGER_PERCENT=
# Estimated recent history tokens retained in raw form after compaction.
DOTAMIND_COMPACTION_KEEP_RECENT_TOKENS=20000
# Summary requests use the model context window, not a fixed input byte limit.
# Their output budget is derived from this reserve (history summaries use 80%).
DOTAMIND_COMPACTION_RESERVE_TOKENS=16384
# Optional explicit output cap for the compaction model; blank means unknown.
DOTAMIND_COMPACTION_MODEL_MAX_OUTPUT_TOKENS=
# Number of retries after the first summary call for transient errors (0 disables retries).
DOTAMIND_COMPACTION_MAX_RETRIES=1
DOTAMIND_TEST_OBSERVER_ENABLED=true
DOTAMIND_DATABASE_URL=postgresql://dotamind:dotamind@localhost:5432/dotamind
DOTAMIND_SESSION_STORE_BACKEND=redis
DOTAMIND_REDIS_URL=redis://localhost:6379/0
DOTAMIND_VNEXT_ARTIFACT_TTL_SECONDS=604800
DOTAMIND_VNEXT_TRACE_TTL_SECONDS=259200
# UTF-8 serialized-byte limits for ordinary tool results and model-visible Artifact reads.
DOTAMIND_TOOL_INLINE_MAX_BYTES=12288
DOTAMIND_TOOL_OBSERVATION_MAX_BYTES=35840
VNEXT_TEST_RECORDING_ENABLED=false
DOTAMIND_MAX_CONCURRENT_CHAT_RUNS=2
DOTAMIND_RUN_HEARTBEAT_SECONDS=5
DOTAMIND_RUN_STALE_SECONDS=60
DOTAMIND_RUN_SWEEPER_INTERVAL_SECONDS=15

NEXT_PUBLIC_DOTAMIND_API_URL=http://localhost:8001
NEXT_PUBLIC_DOTAMIND_TEST_OBSERVER_ENABLED=true
