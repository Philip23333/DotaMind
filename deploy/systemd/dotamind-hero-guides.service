[Unit]
Description=DotaMind hero guide refresh
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/dotamind
ExecStart=/usr/bin/docker compose -f compose.prod.yml exec -T api python -m app.vnext.hero_guides refresh
TimeoutStartSec=infinity
SuccessExitStatus=3
