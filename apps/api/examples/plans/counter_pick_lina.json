{
  "intent": "hero_matchup_ranking",
  "goal": "Fetch counter-pick ranking for a target hero.",
  "output_contract": "natural_language_answer",
  "context": {
    "bracket": ["LEGEND_ANCIENT"],
    "week": null,
    "position_ids": null,
    "region_ids": null,
    "game_mode_ids": null
  },
  "tool_calls": [
    {
      "id": "resolve_target",
      "tool": "resolve_hero",
      "args": {
        "query": "Lina"
      }
    },
    {
      "id": "get_ranking",
      "tool": "stratz.hero_matchup_ranking",
      "args": {
        "hero_id": "$resolve_target.data.hero.hero_id",
        "side": "vs",
        "take": 5,
        "min_sample_size": 100
      }
    }
  ],
  "required_evidence": [
    "hero_identity",
    "matchup_ranking_row",
    "sample_size"
  ],
  "constraints": {
    "max_tool_calls": 3,
    "allow_mock": false
  }
}
